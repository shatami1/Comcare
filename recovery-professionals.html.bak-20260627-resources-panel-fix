<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recovery Professionals Atlanta | ComCare Recovery Support Network</title>
    <meta name="description" content="Find Atlanta rehab technicians, PTA and OTA support, home health aides, caregivers, and recovery coaches through the Comfort Care Recovery Support Network.">
    <meta name="keywords" content="Atlanta Rehab Support, Recovery Professionals Atlanta, Post Surgery Support Atlanta, Rehab Technician Atlanta, Home Recovery Assistance Atlanta, Knee Replacement Recovery Atlanta, Hip Replacement Recovery Atlanta, Mobility Equipment Atlanta, Recovery Equipment Rental Atlanta, Physical Therapy Support Atlanta">
    <link rel="canonical" href="https://comcare.store/recovery-professionals">
    <link rel="stylesheet" href="styles.css">
    <style>
        .network-layout { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 24px; align-items: start; }
        .network-panel, .profile-card, .map-panel { background: #fff; border: 1px solid var(--border-color); border-radius: 10px; padding: 20px; box-shadow: var(--shadow-sm); }
        .network-panel label { font-weight: 700; display: block; margin: 14px 0 6px; }
        .network-panel input, .network-panel select, .network-panel textarea { width: 100%; padding: 0.75rem; border: 2px solid var(--border-color); border-radius: 6px; }
        .profile-list { display: grid; gap: 16px; }
        .profile-card { display: grid; grid-template-columns: 86px minmax(0, 1fr); gap: 16px; }
        .profile-photo { width: 86px; height: 86px; border-radius: 8px; background: #eaf1f7; object-fit: cover; display: grid; place-items: center; color: var(--primary-blue); font-weight: 800; }
        .profile-meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 12px; }
        .profile-meta span { background: #eef7ff; border: 1px solid #cde6fb; border-radius: 999px; padding: 5px 10px; font-size: 0.9rem; }
        .profile-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
        .map-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px; }
        .map-grid span { background: #f7fafc; border: 1px solid var(--border-color); border-radius: 6px; padding: 10px; text-align: center; font-weight: 700; }
        .empty-state { background: #fff; border: 1px dashed var(--border-color); border-radius: 10px; padding: 28px; text-align: center; }
        .network-promo { padding: 34px 20px 0; background: #f8fafc; }
        .network-promo-card { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(280px, 1.05fr); gap: 24px; align-items: center; }
        .network-promo-copy h2 { color: #12355f; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.1; margin-bottom: 10px; }
        .network-promo-copy p { color: var(--light-text); line-height: 1.65; margin-bottom: 18px; }
        .network-promo-image { display: block; overflow: hidden; border: 1px solid var(--border-color); border-radius: 8px; background: #fff; box-shadow: var(--shadow-lg); }
        .network-promo-image img { display: block; width: 100%; height: auto; }
        @media (max-width: 850px) { .network-layout, .profile-card, .network-promo-card { grid-template-columns: 1fr; } .map-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <nav class="navbar"><div class="container"><div class="nav-middle"><div class="nav-identity"><div class="nav-brand"><img src="logo.svg" alt="Comfort Care Logo" class="logo-image"></div><div class="nav-title">Comfort Care</div></div><ul class="nav-menu"><li><a href="home.html">Home</a></li><li><a href="services.html">Services</a></li><li><a href="order.html">Order</a></li><li><a href="pricing.html">Cart</a></li><li><a href="atlanta-sandy-springs-healthcare-resources.html">Resources</a></li><li><a href="recovery-professionals.html" class="active">Recovery Network</a></li><li><a href="contact.html">Contact</a></li></ul></div></div></nav>
    <section class="page-header"><div class="container"><h1>Recovery Professionals Atlanta</h1><p>Search Atlanta rehab support professionals by ZIP code, specialty, and service area.</p></div></section>
    <section class="network-promo" aria-label="Join Atlanta recovery support network">
        <div class="container network-promo-card">
            <div class="network-promo-copy">
                <h2>Join Atlanta's Recovery Support Network</h2>
                <p>Rehab technicians, PTA and OTA assistants, home health aides, caregivers, and recovery coaches can register to be considered for Comfort Care's local recovery ecosystem.</p>
                <a class="btn btn-primary" href="join-professionals.html">Register as a Professional</a>
            </div>
            <a class="network-promo-image" href="join-professionals.html">
                <img src="network-recovery-support.jpg" alt="Join Atlanta's Recovery Support Network with rehab technicians, assistants, home health aides, caregivers, and recovery coaches">
            </a>
        </div>
    </section>
    <section class="contact-section"><div class="container network-layout">
        <aside class="network-panel">
            <h2>Find Support</h2>
            <label for="zipSearch">ZIP code</label><input id="zipSearch" inputmode="numeric" placeholder="30328, 30071, 30305">
            <label for="specialtyFilter">Specialty</label><select id="specialtyFilter"><option value="">All specialties</option><option>Rehab Technician</option><option>Physical Therapy Assistant (PTA)</option><option>Occupational Therapy Assistant (OTA)</option><option>Home Health Aide</option><option>Caregiver</option><option>Recovery Coach</option></select>
            <label for="keywordSearch">Keyword</label><input id="keywordSearch" placeholder="knee replacement, home recovery">
            <div class="tech-actions"><a class="btn btn-primary" href="join-professionals.html">Join Network</a><a class="btn btn-secondary" href="partners.html">Partners</a></div>
            <div class="map-panel" style="margin-top:18px;"><h3>Service Area Map</h3><p>Atlanta recovery support coverage includes metro communities served by Comfort Care.</p><div class="map-grid"><span>Atlanta</span><span>Sandy Springs</span><span>Norcross</span><span>Decatur</span><span>Marietta</span><span>Roswell</span></div></div>
        </aside>
        <main><div id="profileList" class="profile-list"></div></main>
    </div></section>
    <footer class="footer"><div class="container"><div class="footer-bottom"><p>&copy; 2026 Comfort Care. All rights reserved. | Recovery equipment rental Atlanta</p><p>Comfort Care operates as a DBA/trade name of MOON LIGHTING INC.</p></div></div></footer>
    <script>
      (function () {
        var storageKey = 'comcareRecoveryProfessionals';
        var defaults = [
          {id:'sample-1', name:'Atlanta Recovery Support', title:'Rehab Technician', specialty:'Rehab Technician', serviceArea:'Atlanta, Sandy Springs, Norcross, 30328, 30305', certifications:'Mobility support, discharge support', yearsExperience:'5+', phone:'678-362-2345', email:'admin@comcare.store', website:'https://comcare.store', linkedin:'', bio:'Comfort Care is building a trusted Atlanta recovery support network for patients who need more than equipment after surgery, injury, or rehabilitation.', featured:true, verified:true, photoUrl:''}
        ];
        var remoteProfiles = [];
        var statusNote = document.createElement('p');
        statusNote.style.marginTop = '12px';
        statusNote.style.color = 'var(--light-text)';
        document.querySelector('.network-panel').appendChild(statusNote);
        function mapRemote(item) { return { id:item.id, name:item.name, title:item.title, specialty:item.specialty, certifications:item.certifications, yearsExperience:item.years_experience, phone:item.phone, email:item.email, website:item.website, linkedin:item.linkedin, serviceArea:item.service_area, bio:item.bio, photoUrl:item.photo_url, featured:item.featured, verified:item.verified, createdAt:item.created_at }; }
        function local() { try { return JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch (e) { return []; } }
        function all() { return remoteProfiles.length ? remoteProfiles : defaults.concat(local()); }
        function esc(value) { return String(value || '').replace(/[&<>"']/g, function (m) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]; }); }
        function initials(name) { return String(name || 'CC').split(/\s+/).map(function (part) { return part.charAt(0); }).join('').slice(0,2).toUpperCase(); }
        function profilePhoto(item) { return item.photoUrl ? '<img class="profile-photo" src="' + esc(item.photoUrl) + '" alt="' + esc(item.name) + '">' : '<div class="profile-photo">' + initials(item.name) + '</div>'; }
        function matches(item) {
          var zip = document.getElementById('zipSearch').value.trim().toLowerCase();
          var specialty = document.getElementById('specialtyFilter').value;
          var keyword = document.getElementById('keywordSearch').value.trim().toLowerCase();
          var text = [item.name,item.title,item.specialty,item.certifications,item.serviceArea,item.bio].join(' ').toLowerCase();
          return (!zip || text.indexOf(zip) !== -1) && (!specialty || item.specialty === specialty) && (!keyword || text.indexOf(keyword) !== -1);
        }
        function contactLink(item) { var body = 'I would like recovery support information for the Atlanta area.\n\nProfessional: ' + (item.name || '') + '\nSpecialty: ' + (item.specialty || '') + '\nService area: ' + (item.serviceArea || ''); return 'mailto:admin@comcare.store?cc=accentGV%40gmail.com&subject=' + encodeURIComponent('Recovery professional referral request') + '&body=' + encodeURIComponent(body); }
        function render() {
          var list = all().filter(matches);
          var target = document.getElementById('profileList');
          if (!list.length) { target.innerHTML = '<div class="empty-state"><h2>No matching professionals yet</h2><p>Try a different ZIP code or invite a local provider to join the network.</p><a class="btn btn-primary" href="join-professionals.html">Join Atlanta\'s Recovery Support Network</a></div>'; return; }
          target.innerHTML = list.map(function (item) { return '<article class="profile-card">' + profilePhoto(item) + '<div><h2>' + esc(item.name) + '</h2><p><strong>' + esc(item.title || item.specialty) + '</strong></p><div class="profile-meta"><span>' + esc(item.specialty) + '</span><span>' + esc(item.yearsExperience) + ' years</span>' + (item.verified ? '<span>Verified</span>' : '') + (item.featured ? '<span>Featured</span>' : '') + '</div><p>' + esc(item.bio) + '</p><p><strong>Service area:</strong> ' + esc(item.serviceArea) + '</p><p><strong>Certifications:</strong> ' + esc(item.certifications) + '</p><div class="profile-actions"><a class="btn btn-primary btn-compact" href="' + contactLink(item) + '">Contact</a>' + (item.website ? '<a class="btn btn-secondary btn-compact" href="' + esc(item.website) + '">Website</a>' : '') + (item.linkedin ? '<a class="btn btn-secondary btn-compact" href="' + esc(item.linkedin) + '">LinkedIn</a>' : '') + '</div></div></article>'; }).join('');
        }
        function loadRemote() {
          statusNote.textContent = 'Loading approved recovery professionals...';
          fetch('/api/recovery-professionals').then(function (response) { return response.json(); }).then(function (data) {
            if (data.status === 'ok') {
              remoteProfiles = (data.professionals || []).map(mapRemote);
              statusNote.textContent = remoteProfiles.length ? 'Showing approved professionals from the live database.' : 'No approved database profiles yet.';
              render();
            } else {
              statusNote.textContent = data.message || 'Database is not connected yet; showing browser-saved sample records.';
            }
          }).catch(function () { statusNote.textContent = 'Database is not connected yet; showing browser-saved sample records.'; });
        }
        ['zipSearch','specialtyFilter','keywordSearch'].forEach(function (id) { document.getElementById(id).addEventListener('input', render); document.getElementById(id).addEventListener('change', render); });
        render();
        loadRemote();
      }());
    </script>
    <script src="site-navigation.js"></script>
<script src="live-chat.js"></script>
</body>
</html>
