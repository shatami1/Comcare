# Example environment values. Copy this file to .env and fill in real values locally.
# Never commit real payment access tokens or webhook secrets.
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_APPLICATION_ID=your_square_application_id_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key_here

# Supabase order automation
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ORDER_ADMIN_TOKEN=create_your_private_order_dashboard_password

# Optional: automatic customer confirmation emails.
# Without these, the order still saves and the dashboard shows prepared email text.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=ComCare Store <admin@comcare.store>
